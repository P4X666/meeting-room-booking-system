# 邮件服务配置
# SMTP 服务器地址
MAIL_HOST=smtp.qq.com
# SMTP 端口（465 使用 SSL，587 使用 STARTTLS）
MAIL_PORT=465
# 是否启用 SSL/TLS 加密（端口 465 必须为 true）
MAIL_SECURE=true
# 邮件服务器用户名（通常是邮箱地址）
MAIL_USER=your-email@example.com
# 邮件服务器密码或授权码
MAIL_PASS=your-email-password
# 发件人名称
MAIL_FROM_NAME=会议室预定系统
# 发件人邮箱地址
MAIL_FROM_ADDRESS=your-email@example.com